{
  "name": "school-teacher-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:migrate": "dotenv -e server/.env -- prisma migrate dev --schema server/prisma/schema.prisma",
    "server:migrate:deploy": "dotenv -e server/.env -- prisma migrate deploy --schema server/prisma/schema.prisma",
    "server:seed": "node server/prisma/seed.js"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "googleapis": "^173.0.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.26.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
